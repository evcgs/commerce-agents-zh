# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment / secrets
.env
.env.*
!.env.example

# Node / Next.js (vertical example frontends)
node_modules/
.next/
next-env.d.ts
examples/*/*-web/AGENTS.md
examples/*/*-web/CLAUDE.md
out/
*.tsbuildinfo
npm-debug.log*


# Example runtime state. The memory files hold whatever a local demo
# remembered — personal data in a real deployment — and are never committed.
examples/*/data/.memory-*.json
shopping-agent/managed-agents/storefront-mcp-server/.storefront_memory.json
merchant-agent/managed-agents/merchant-mcp-server/.merchant_memory.json

# OS / editor / local tooling
.DS_Store
.idea/
.vscode/
.claude/
pyrightconfig.json

# commerce-agents-zh: run-time model settings (can carry an API key)
examples/retail/data/model-override.json
# commerce-agents-zh: run-time prompt overrides (static system prompts)
examples/retail/data/prompt-override.json
# commerce-agents-zh: prompt-version history (editable timeline; carries prompt text)
examples/retail/data/prompt-versions.json
# commerce-agents-zh: run-time data-source settings (can carry an API key)
examples/retail/data/backend-override.json

# commerce-agents-zh: agentctl runtime artifacts (logs + pidfile)
logs/
examples/retail/data/.agentctl.pids
